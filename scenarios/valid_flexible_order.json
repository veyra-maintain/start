{
  "id": "valid_flexible_order",
  "name": "1. Valid Flexible Order (1,2,4,3,5,6,8,7,9,10)",
  "description": "Tests full installation with valid permutations allowed by DAG (steps 4 before 3, step 8 before 7).",
  "steps": [
    {
      "step_id": 1,
      "action": "toggle_psu",
      "expected_verdict": "ok",
      "state_setup": { "psu": "off", "power_cable_plugged": false }
    },
    {
      "step_id": 2,
      "action": "discharge_esd",
      "expected_verdict": "ok",
      "state_setup": { "esd_discharged": true }
    },
    {
      "step_id": 4,
      "action": "peel_film",
      "expected_verdict": "ok",
      "state_setup": { "film_on": false }
    },
    {
      "step_id": 3,
      "action": "wipe_cpu",
      "expected_verdict": "ok",
      "state_setup": { "cpu_clean": true }
    },
    {
      "step_id": 5,
      "action": "apply_paste",
      "payload": { "size": 0.45, "offset": 0.05 },
      "expected_verdict": "ok",
      "state_setup": { "paste": { "present": true, "size": 0.45, "offset_from_center": 0.05 } }
    },
    {
      "step_id": 6,
      "action": "seat_cooler",
      "expected_verdict": "ok",
      "state_setup": { "cooler": "seated" }
    },
    {
      "step_id": 8,
      "action": "connect_fan",
      "expected_verdict": "ok",
      "state_setup": { "fan_connected": true }
    },
    {
      "step_id": 7,
      "action": "turn_screw",
      "payload": { "index": 0, "delta": 1 },
      "expected_verdict": "ok",
      "state_setup": { "screw": [6, 6, 6, 6] }
    },
    {
      "step_id": 9,
      "action": "toggle_psu",
      "expected_verdict": "ok",
      "state_setup": { "psu": "on", "power_cable_plugged": true }
    },
    {
      "step_id": 10,
      "action": "verify_sensors",
      "expected_verdict": "ok"
    }
  ]
}
