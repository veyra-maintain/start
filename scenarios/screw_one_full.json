{
  "id": "screw_one_full",
  "name": "6. Screw One Full First (Uneven Tightening)",
  "description": "Technician tightens screw 1 excessively ahead of other screws, violating the diagonal balance constraint.",
  "steps": [
    {
      "step_id": 1,
      "action": "toggle_psu",
      "expected_verdict": "ok",
      "state_setup": { "psu": "off", "power_cable_plugged": false }
    },
    {
      "step_id": 2,
      "action": "discharge_esd",
      "expected_verdict": "ok",
      "state_setup": { "esd_discharged": true }
    },
    {
      "step_id": 4,
      "action": "peel_film",
      "expected_verdict": "ok",
      "state_setup": { "film_on": false }
    },
    {
      "step_id": 3,
      "action": "wipe_cpu",
      "expected_verdict": "ok",
      "state_setup": { "cpu_clean": true }
    },
    {
      "step_id": 5,
      "action": "apply_paste",
      "payload": { "size": 0.45, "offset": 0.05 },
      "expected_verdict": "ok",
      "state_setup": { "paste": { "present": true, "size": 0.45, "offset_from_center": 0.05 } }
    },
    {
      "step_id": 6,
      "action": "seat_cooler",
      "expected_verdict": "ok",
      "state_setup": { "cooler": "seated" }
    },
    {
      "step_id": 7,
      "action": "turn_screw",
      "payload": { "index": 0, "delta": 4 },
      "expected_verdict": "out_of_order",
      "state_setup": { "screw": [4, 0, 0, 0] }
    }
  ]
}
